# Public browser values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Local admin fallback. The configure script derives a salted password hash;
# the plaintext password is never written to browser configuration.
ADMIN_USERNAME=YAM
ADMIN_PASSWORD=choose-a-strong-password

# Supabase Edge Function secrets — never place these in config.js
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=YAM
